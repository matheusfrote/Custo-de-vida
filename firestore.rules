rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (used by initialization check)
    match /test/{docId} {
      allow read: if true;
    }

    // User documents and their financial subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update, delete: if isOwner(userId) && isValidId(userId);

      match /expenses/{expenseId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(expenseId);
      }

      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(historyId);
      }

      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(goalId);
      }
    }
  }
}
